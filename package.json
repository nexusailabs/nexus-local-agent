{
  "name": "nexus-local-agent",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:model-route": "node --test ops/macos/model-route-proxy.node-test.mjs",
    "dev:control": "tsx apps/control-plane/src/index.ts",
    "dev:node": "tsx apps/node-daemon/src/index.ts",
    "mcp": "node apps/mcp-adapter/dist/index.js",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/sensible": "^6.0.0",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.0.0",
    "html-to-text": "^10.0.1",
    "nanoid": "^5.0.0",
    "openai": "^7.8.0",
    "pino": "^9.0.0",
    "playwright": "1.62.1",
    "yaml": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
