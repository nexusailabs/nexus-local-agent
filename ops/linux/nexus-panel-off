#!/bin/bash
set -euo pipefail

# The Z13 boots to a Linux virtual console. DRM property writes report success
# but are immediately overridden by that console, leaving eDP powered. Make the
# console itself own blanking and re-assert it after any local input wakes it.
while true; do
  if test -c /dev/tty1; then
    /usr/bin/setterm --blank force --term linux </dev/tty1 >/dev/tty1
  fi
  /usr/bin/sleep 5
done
