#!/bin/bash
set -euo pipefail

# The Z13 boots to a Linux framebuffer console. DRM property and setterm writes
# are overridden during boot, leaving eDP powered. FB_BLANK_POWERDOWN (4) makes
# that console power down its panel; re-assert it after any local input wakes it.
while true; do
  if test -w /sys/class/graphics/fb0/blank; then
    echo 4 >/sys/class/graphics/fb0/blank
  fi
  /usr/bin/sleep 5
done
