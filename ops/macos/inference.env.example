# Copy to ~/.config/nexus-local-agent/inference.env on the MBP.
# The first route is preferred. The daemon falls back and promotes automatically.
NEXUS_CONTROL_URL=http://169.254.77.3:7788
NEXUS_NODE_BASE_URL=http://169.254.77.1:7790
NEXUS_CONTROL_ROUTES_JSON='[{"name":"tb4","controlUrl":"http://169.254.77.3:7788","nodeBaseUrl":"http://169.254.77.1:7790"},{"name":"tailscale","controlUrl":"http://100.x.y.z:7788","nodeBaseUrl":"http://100.a.b.c:7790"}]'
NEXUS_MODEL_BASE_URL=http://127.0.0.1:18080/v1
NEXUS_MODEL_ID=Qwen3.8-Flash-Next-MLX-Serve-mixed-4-8bit
NEXUS_MODEL_PROVIDER=mlx-serve
NEXUS_MODEL_CONTEXT_WINDOW=131072
NEXUS_MODEL_MAX_OUTPUT_TOKENS=32768
