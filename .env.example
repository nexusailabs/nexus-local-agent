NEXUS_BIND=0.0.0.0
NEXUS_CONTROL_PORT=7788
NEXUS_NODE_PORT=7790
NEXUS_SHARED_TOKEN=replace-with-long-random-token
NEXUS_STATE_DIR=.state
NEXUS_CONFIG=config/cluster.yaml
NEXUS_TASK_PARALLELISM=3

# Deep Research. Configure one or more. SearXNG is ideal for a self-hosted default.
NEXUS_SEARXNG_URL=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# Node daemon registration.
NEXUS_CONTROL_URL=http://mba-m4-control.local:7788
NEXUS_NODE_ID=z13-strix-halo
NEXUS_NODE_BASE_URL=http://z13.local:7790
NEXUS_NODE_CAPABILITIES=inference,exec,fs,git,containers,browser,computer,code,documents,ci,long-running
NEXUS_NODE_REACHABILITY=lan
NEXUS_NODE_TAGS=strix-halo,rocm,vulkan
NEXUS_EXECUTION_CLASS=96
NEXUS_RELIABILITY_CLASS=90
NEXUS_HEARTBEAT_MS=10000
NEXUS_MODELS_JSON=[]

# Browser executor. Run `pnpm exec playwright install chromium` on nodes advertising browser.
NEXUS_BROWSER_HEADLESS=true
NEXUS_BROWSER_WIDTH=1440
NEXUS_BROWSER_HEIGHT=1000
